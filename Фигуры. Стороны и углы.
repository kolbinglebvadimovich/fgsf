#include <iostream>
#include <string>
#include <cmath>


protected:
    std::string name;

public:
    explicit Shape(const std::string& n) : name(n) {}

    virtual ~Shape() = default;

    
    virtual bool isValid() const {
        return true;
    }

    void basePrintInfo() const 
    {
        std::cout << "Фигура: " << name << "\n" << std::endl;
    }

    virtual void printInfo() const = 0;
};


class Triangle : public Shape 
{
private:
    double a, b, c;

public:
    Triangle(double sideA, double sideB, double sideC)
        : Shape("Треугольник"), a(sideA), b(sideB), c(sideC) {}

    bool isValid() const override 
    {
        if (a <= 0 || b <= 0 || c <= 0) return false;
        return (a + b > c) && (a + c > b) && (b + c > a);
    }

    void printInfo() const override 
    {
        basePrintInfo();
        std::cout << "  Стороны: a = " << a << ", b = " << b << ", c = " << c << "\n" << std::endl;

        if (isValid()) 
        {
            std::cout << "  Статус: корректная фигура (неравенство треугольника выполняется)\n" << std::endl;
        } else 
        {
            std::cout << "  Статус: некорректная фигура (нарушено неравенство треугольника)\n" << std::endl;
        }
    }
};


class Rectangle : public Shape 
{
private:
    double width, height;

public:
    Rectangle(double w, double h)
        : Shape("Прямоугольник"), width(w), height(h) {}

    bool isValid() const override 
    {
        return width > 0 && height > 0;
    }

    void printInfo() const override 
    {
        basePrintInfo();
        std::cout << "  Ширина: " << width << ", высота: " << height << "\n" << std::endl;

        if (isValid()) 
        {
            std::cout << "  Статус: корректный прямоугольник\n" << std::endl;
        } else 
        {
            std::cout << "  Статус: некорректный прямоугольник (стороны должны быть положительными)\n" << std::endl;
        }
    }
};


class Square : public Shape 
{
private:
    double side;

public:
    explicit Square(double s)
        : Shape("Квадрат"), side(s) {}

    bool isValid() const override 
    {
        return side > 0;
    }

    void printInfo() const override 
    {
        basePrintInfo();
        std::cout << "  Сторона: " << side << "\n" << std::endl;

        if (isValid()) 
        {
            std::cout << "  Статус: корректный квадрат\n" << std::endl;
        } else 
        {
            std::cout << "  Статус: некорректный квадрат (сторона должна быть положительной)\n" << std::endl;
        }
    }
};

int main() 
{
    
    Triangle t(3.0, 4.0, 5.0);
    Rectangle r(6.5, 4.2);
    Square sq(5.0);

   
    t.printInfo();
    std::cout << "\n" << std::endl;
    r.printInfo();
    std::cout << "\n" << std::endl;
    sq.printInfo();

    
    std::cout << "\n--- Проверка некорректной фигуры ---\n" << std::endl;
    Triangle badT(1.0, 2.0, 10.0);
    badT.printInfo();

    return 0;
}
