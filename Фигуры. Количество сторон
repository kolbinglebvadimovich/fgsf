#include <iostream>
#include <string>


class Shape 
{
public:
    virtual ~Shape() = default;

   
    virtual int getSides() const = 0;

   
    virtual void printInfo() const 
    {
        std::cout << "Фигура: неизвестная, сторон: " << getSides() << "\n" << std::endl;
    }
};


class Triangle : public Shape 
{
public:
    int getSides() const override 
    {
        return 3;
    }

    void printInfo() const override 
    {
        std::cout << "Треугольник, сторон: " << getSides() << "\n" << std::endl;
    }
};


class Rectangle : public Shape 
{
public:
    int getSides() const override 
    {
        return 4;
    }

    void printInfo() const override 
    {
        std::cout << "Прямоугольник, сторон: " << getSides() << "\n" << std::endl;
    }
};


class Square : public Shape 
{
public:
    int getSides() const override 
    {
        return 4;
    }

    void printInfo() const override 
    {
        std::cout << "Квадрат, сторон: " << getSides() << "\n" << std::endl;
    }
};


class Pentagon : public Shape 
{
public:
    int getSides() const override 
    {
        return 5;
    }

    void printInfo() const override 
    {
        std::cout << "Пятиугольник, сторон: " << getSides() << "\n" << std::endl;
    }
};

int main() 
{
   
    Triangle triangle;
    Rectangle rectangle;
    Square square;
    Pentagon pentagon;

    
    triangle.printInfo();
    rectangle.printInfo();
    square.printInfo();
    pentagon.printInfo();

   
    std::cout << "\n--- Полиморфизм через указатели ---\n" << std::endl;
    const Shape* shapes[] = { &triangle, &rectangle, &square, &pentagon };

    for (const auto* s : shapes) 
    {
        s->printInfo();
    }

    return 0;
}
