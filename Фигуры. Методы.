#include <iostream>
#include <string>

class Shape 
{
protected:
    int sides_count;
    std::string name;

public:
    Shape(int sides, const std::string& n) : sides_count(sides), name(n) {}
    virtual ~Shape() = default;

    int getSidesCount() const { return sides_count; }
    std::string getName() const { return name; }

    virtual void printInfo() const = 0;
    virtual bool isValid() const = 0;
}

class Triangle : public Shape 
{
protected:
    double a, b, c;
    double A, B, C;

public:
    Triangle(double a, double b, double c, double A, double B, double C)
        : Shape(3, "Треугольник"), a(a), b(b), c(c), A(A), B(B), C(C) {}

    void printInfo() const override 
  {
        std::cout << name << "\nСтороны: a=" << a << " b=" << b << " c=" << c << "\nУглы: A=" << A << " B=" << B << " C=" << C << std::endl;
    }

    bool isValid() const override 
  {
        return (A + B + C == 180);
    }
}



class RightTriangle : public Triangle 
{
public:
    RightTriangle(double a, double b, double A, double B)
        : Triangle(a, b, sqrt(a*a + b*b), A, B, 90.0) {}
}

class IsoscelesTriangle : public Triangle 
{
public:
    IsoscelesTriangle(double a, double b, double A)
        : Triangle(a, a, b, A, A, 180.0 - 2*A) {}
}

class EquilateralTriangle : public Triangle 
{
public:
    EquilateralTriangle(double a)
        : Triangle(a, a, a, 60.0, 60.0, 60.0) {}
}
class Quadrilateral : public Shape 
{
protected:
    double a, b, c, d;
    double A, B, C, D;

public:
    Quadrilateral(double a, double b, double c, double d, double A, double B, double C, double D)
        : Shape(4, "Четырёхугольник"), a(a), b(b), c(c), d(d), A(A), B(B), C(C), D(D) {}

    void printInfo() const override 
    {
        std::cout << name << "\nСтороны: a=" << a << " b=" << b << " c=" << c << " d=" << d << "\nУглы: A=" << A << " B=" << B << " C=" << C << " D=" << D << std::endl;
    }

    bool isValid() const override 
    {
        return (A + B + C + D == 360);
    }
}



class Rectangle : public Quadrilateral 
{
public:
    Rectangle(double a, double b)
        : Quadrilateral(a, b, a, b, 90.0, 90.0, 90.0, 90.0) {}
}

class Square : public Rectangle 
{
public:
    Square(double a)
        : Rectangle(a, a) {}
}

class Parallelogram : public Quadrilateral 
{
public:
    Parallelogram(double a, double b, double A)
        : Quadrilateral(a, b, a, b, A, 180.0 - A, A, 180.0 - A) {}
}

class Rhombus : public Parallelogram 
{
public:
  Rhombus(double a, double A)
        : Parallelogram(a, a, A) 
    {
        name = "Ромб";
    }

    bool isValid() const override 
    {
        return (A + B + C + D == 360) && (A == C) && (B == D) && (a == b);
    }
}

**Прямоугольник:**
class Rectangle : public Quadrilateral 
{
public:
    Rectangle(double a, double b)
        : Quadrilateral(a, b, a, b, 90.0, 90.0, 90.0, 90.0) 
    {
        name = "Прямоугольник";
    }

    bool isValid() const override 
    {
        return (A == C) && (B == D) && (A == 90);
    }
}

**Квадрат:**
class Square : public Rectangle 
{
public:
    Square(double a)
        : Rectangle(a, a) 
    {
        name = "Квадрат";
    }

    bool isValid() const override 
    {
        return (A == C) && (B == D) && (A == 90);
    }
}


int main() 
{
    Shape* shapes[] = 
  {
        new Triangle(10, 20, 30, 50, 60, 70),
        new RightTriangle(10, 20, 50, 60),
        new IsoscelesTriangle(10, 20, 50),
        new EquilateralTriangle(30),
        new Quadrilateral(10, 20, 30, 40, 50, 60, 70, 80),
        new Rectangle(10, 20),
        new Square(20),
        new Parallelogram(20, 30, 30),
        new Rhombus(30, 30)
  } 

    for (Shape* shape : shapes) 
{    
    {
        std::cout << "\nФигура: " << shape->getName() << std::endl;
        std::cout << "Правильная: " << (shape->isValid() ? "Да" : "Нет") << std::endl;
        std::cout << "Количество сторон: " << shape->getSidesCount() << std::endl;
        
        if (shape->isValid()) 
        {
            shape->printInfo();
        }
        
        delete shape;
    }

    return 0;
}
