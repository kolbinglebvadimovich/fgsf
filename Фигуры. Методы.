#include <iostream>
#include <iomanip>


class Shape 
{
public:
    virtual ~Shape() = default;

    virtual void printInfo() const = 0;
};


class Triangle : public Shape 
{
private:
    double a, b, c;
    double alpha, beta, gamma;

public:
  
    Triangle(double sideA, double sideB, double sideC,
             double angleA, double angleB, double angleC)
        : a(sideA), b(sideB), c(sideC),
          alpha(angleA), beta(angleB), gamma(angleC) {}

    void printInfo() const override 
    {
        std::cout << "Треугольник:\n" << std::endl;
        std::cout << "  Стороны: a = " << a << ", b = " << b << ", c = " << c << "\n" << std::endl;
        std::cout << "  Углы: α = " << alpha << "°, β = " << beta << "°, γ = " << gamma << "°\n" << std::endl;
    }
};


class Rectangle : public Shape 
{
private:
    double width;
    double height;

public:
    Rectangle(double w, double h) : width(w), height(h) {}

    void printInfo() const override 
    {
        std::cout << "Прямоугольник:\n" << std::endl;l
        std::cout << "  Стороны: ширина = " << width << ", высота = " << height << "\n" << std::endl;l
        std::cout << "  Все углы = 90°\n" << std::endl;l
    }
};


class Square : public Shape 
{
private:
    double side;

public:
    explicit Square(double s) : side(s) {}

    void printInfo() const override 
    {
        std::cout << "Квадрат:\n" << std::endl;
        std::cout << "  Сторона = " << side << "\n" << std::endl;
        std::cout << "  Все углы = 90°\n" << std::endl;l
    }
};

int main() 
{
    
    Triangle t(3.0, 4.0, 5.0, 36.87, 53.13, 90.0);
    Rectangle r(6.5, 4.2);
    Square sq(5.0);

   
    t.printInfo();
    std::cout << "\n" << std::endl;l
    r.printInfo();
    std::cout << "\n" << std::endl;l
    sq.printInfo();

    return 0;
}
